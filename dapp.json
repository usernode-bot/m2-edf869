{
  "description": "Build modern, easy-to-use mind maps",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🧠"
  },
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "name": "map.demo",
      "path": "/?demo=1",
      "visual": true,
      "id": "map.demo",
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "server/**",
        "tailwind.config.js"
      ],
      "expectSelector": ".idea-central",
      "expectText": "Lisbon weekend"
    },
    {
      "name": "map.demo-undo",
      "path": "/?demo=1",
      "expectSelector": ".topbar .undo-btn"
    },
    {
      "name": "map.demo-maps-list",
      "path": "/?demo=1#/maps",
      "expectText": "Staging demo maps"
    },
    {
      "name": "map.first-visit-example",
      "path": "/",
      "expectText": "Welcome to M2"
    },
    {
      "name": "map.shared-link",
      "path": "/?share=staging-demo-link",
      "visual": true,
      "id": "map.shared-link",
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "server/**",
        "tailwind.config.js"
      ],
      "expectSelector": ".view-pill",
      "expectText": "View only"
    },
    {
      "name": "map.shared-link-gone",
      "path": "/?share=not-a-real-link",
      "expectText": "It may be private now"
    },
    {
      "name": "map.demo-shared-with-you",
      "path": "/?demo=1#/maps",
      "expectText": "Shared with you"
    },
    {
      "name": "map.demo-tidy-button",
      "path": "/?demo=1",
      "expectSelector": ".topbar .tidy-btn"
    },
    {
      "name": "map.shortcuts-button",
      "path": "/?demo=1",
      "expectSelector": ".kbd-btn"
    }
  ]
}
