{
  "description": "Build modern, easy-to-use mind maps",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🧠"
  },
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "name": "map.demo",
      "path": "/?demo=1",
      "visual": true,
      "id": "map.demo",
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "server/**",
        "tailwind.config.js"
      ],
      "expectSelector": ".idea-central",
      "expectText": "Lisbon weekend"
    },
    {
      "name": "map.demo-undo",
      "path": "/?demo=1",
      "expectSelector": ".topbar .undo-btn"
    },
    {
      "name": "map.demo-tree",
      "path": "/?demo=1",
      "expectSelector": "[role=\"tree\"] [role=\"treeitem\"][aria-level=\"1\"][tabindex=\"0\"]"
    },
    {
      "name": "map.demo-announcer",
      "path": "/?demo=1",
      "expectSelector": "#announcer[aria-live=\"polite\"]"
    },
    {
      "name": "map.demo-maps-list",
      "path": "/?demo=1#/maps",
      "expectText": "Staging demo maps"
    },
    {
      "name": "map.first-visit-example",
      "path": "/",
      "expectText": "Welcome to M2"
    },
    {
      "name": "map.shared-link",
      "path": "/?share=staging-demo-link",
      "visual": true,
      "id": "map.shared-link",
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "server/**",
        "tailwind.config.js"
      ],
      "expectSelector": ".view-pill",
      "expectText": "View only"
    },
    {
      "name": "map.shared-link-gone",
      "path": "/?share=not-a-real-link",
      "expectText": "It may be private now"
    },
    {
      "name": "map.demo-shared-with-you",
      "path": "/?demo=1#/maps",
      "expectText": "Shared with you"
    },
    {
      "name": "map.demo-tidy-button",
      "path": "/?demo=1",
      "expectSelector": ".topbar .tidy-btn"
    },
    {
      "name": "map.shortcuts-button",
      "path": "/?demo=1",
      "expectSelector": ".kbd-btn"
    },
    {
      "name": "map.demo-zoom",
      "path": "/?demo=1",
      "expectSelector": ".zoom-group .zoom-level"
    },
    {
      "name": "map.find-button",
      "path": "/?demo=1",
      "expectSelector": ".topbar .find-btn"
    },
    {
      "name": "map.demo-more-button",
      "path": "/?demo=1",
      "expectSelector": ".topbar .more-btn"
    },
    {
      "name": "map.demo-recently-deleted",
      "path": "/?demo=1#/maps",
      "expectText": "Recently deleted"
    },
    {
      "name": "map.demo-trash-list",
      "path": "/?demo=1#/trash",
      "expectText": "Deletes in"
    },
    {
      "name": "map.demo-live-stream",
      "path": "/?demo=1",
      "expectSelector": ".canvas[data-live=\"open\"]"
    },
    {
      "name": "map.shared-link-presence",
      "path": "/?share=staging-demo-link",
      "expectSelector": ".topbar .presence .presence-dot",
      "expectText": "Staging demo friend"
    }
  ]
}
